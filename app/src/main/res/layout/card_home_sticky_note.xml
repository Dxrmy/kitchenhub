<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardStickyRoot"
    android:layout_width="380dp"
    android:layout_height="match_parent"
    app:cardBackgroundColor="@color/note_paper_yellow"
    app:cardCornerRadius="32dp"
    app:cardElevation="6dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="26dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvNoteAuthor"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Sticky Notes"
                android:textColor="@color/note_ink_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvNoteAuthorBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_handle"
                android:backgroundTint="#18000000"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:text="Kyle"
                android:textColor="@color/note_ink_secondary"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvNoteBody"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:lineSpacingMultiplier="1.18"
            android:maxLines="7"
            android:text="Tap Speak below to leave a note."
            android:textColor="@color/note_ink_primary"
            android:textSize="24sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNoteSpeak"
                style="@style/Widget.Material3Expressive.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Speak"
                android:textAllCaps="false"
                android:textColor="@color/note_ink_primary"
                android:textSize="15sp"
                app:backgroundTint="@color/note_chip_bg"
                app:cornerRadius="999dp"
                app:icon="@drawable/ic_mic_rounded"
                app:iconGravity="textStart"
                app:iconPadding="10dp"
                app:iconTint="@color/note_ink_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNoteDone"
                style="@style/Widget.Material3Expressive.Button"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="20dp"
                android:text="Done"
                android:textAllCaps="false"
                android:textColor="@color/note_paper_yellow"
                android:textSize="15sp"
                app:backgroundTint="@color/note_ink_primary"
                app:cornerRadius="999dp"
                app:icon="@drawable/ic_check_rounded"
                app:iconTint="@color/note_paper_yellow" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
