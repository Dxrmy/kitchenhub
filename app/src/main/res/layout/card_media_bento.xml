<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

<LinearLayout
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="horizontal">

    <!-- Left Column: Full-Height Now Playing Card -->
    <include
        android:id="@+id/nowPlayingInclude"
        layout="@layout/card_media_now_playing"
        android:layout_width="360dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="16dp" />

    <!-- Right Column: YouTube Music (Top) + YouTube (Bottom) Stacked -->
    <LinearLayout
        android:layout_width="350dp"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

        <include
            android:id="@+id/ytMusicInclude"
            layout="@layout/card_app_feature"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="16dp"
            android:layout_weight="1" />

        <include
            android:id="@+id/ytInclude"
            layout="@layout/card_app_feature"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>
</LinearLayout>
</FrameLayout>
