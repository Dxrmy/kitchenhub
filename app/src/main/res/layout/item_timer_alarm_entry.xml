<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/entryCardRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/m3_surface_container_high"
    app:cardCornerRadius="22dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivEntryIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="12dp"
                android:src="@drawable/ic_alarm_rounded"
                app:tint="@color/m3_primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvEntryPrimary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:text="08:30"
                    android:textColor="@color/m3_on_surface"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvEntrySecondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fri • Alarm ON"
                    android:textColor="@color/m3_on_surface_variant"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Timer Action Controls (hidden for Official Alarm rows) -->
            <LinearLayout
                android:id="@+id/timerRowActions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRowPlus1"
                    style="@style/Widget.Material3Expressive.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="10dp"
                    android:text="+1m"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    app:cornerRadius="999dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRowPause"
                    style="@style/Widget.Material3Expressive.Button.IconButton.Filled"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    app:icon="@drawable/ic_pause_rounded"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="18dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRowDismiss"
                    style="@style/Widget.Material3Expressive.Button.IconButton.Tonal"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    app:icon="@drawable/ic_close_rounded"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="16dp" />
            </LinearLayout>

            <!-- Official Alarm ON Pill Badge -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/alarmOnBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/m3_secondary_container"
                app:cardCornerRadius="999dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="5dp"
                    android:text="ON"
                    android:textColor="@color/m3_on_secondary_container"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/timerRowProgress"
            style="@style/Widget.Material3Expressive.LinearProgressIndicator.Wavy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:max="100"
            android:progress="0"
            android:visibility="gone"
            app:indicatorColor="@color/m3_primary"
            app:trackColor="#28FFFFFF"
            app:trackCornerRadius="999dp"
            app:trackThickness="6dp"
            app:waveAmplitude="3dp"
            app:waveSpeed="14dp"
            app:wavelength="18dp"
            app:wavelengthDeterminate="18dp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
