<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardFeatureRoot"
    android:layout_width="340dp"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/m3_surface_container"
    app:cardCornerRadius="32dp"
    app:cardElevation="4dp"
    app:strokeWidth="0dp">

    <com.kyle.kitchenhub.core.ui.BentoRippleHostLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="26dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/iconBadgeContainer"
            android:layout_width="64dp"
            android:layout_height="64dp"
            app:cardBackgroundColor="@color/m3_surface_container_high"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <ImageView
                android:id="@+id/ivFeatureIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:scaleType="fitCenter" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvFeatureTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="YouTube Music"
            android:textColor="@color/m3_on_surface"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvFeatureSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingMultiplier="1.2"
            android:text="Browse playlists, mixes &amp; radio stations"
            android:textColor="@color/m3_on_surface_variant"
            android:textSize="15sp" />

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFeatureAction"
            style="@style/Widget.Material3Expressive.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Open"
            android:textAllCaps="false"
            android:textSize="15sp"
            app:cornerRadius="999dp" />
    </LinearLayout>
    </com.kyle.kitchenhub.core.ui.BentoRippleHostLayout>
</com.google.android.material.card.MaterialCardView>
