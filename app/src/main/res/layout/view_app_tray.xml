<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/appTrayCard"
    android:layout_width="match_parent"
    android:layout_height="416dp"
    android:layout_gravity="bottom"
    app:cardBackgroundColor="@color/shade_frosted_bg"
    app:cardElevation="20dp"
    app:shapeAppearanceOverlay="@style/ShapeAppearance.KitchenHub.BottomDrawer28"
    app:strokeColor="#1FFFFFFF"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="36dp"
        android:paddingTop="12dp"
        android:paddingBottom="56dp">

        <!-- Swipe-down Drag Handle Pill -->
        <View
            android:layout_width="52dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_pill_handle" />

        <!-- Header Row: Title + Small Circular X Icon Fallback -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTrayTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Apps"
                android:textColor="@color/m3_on_surface"
                android:textSize="20sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCloseTrayIcon"
                style="@style/Widget.Material3Expressive.Button.IconButton.Tonal"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:contentDescription="Close App Drawer"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                app:backgroundTint="@color/m3_surface_container_high"
                app:icon="@drawable/ic_close_rounded"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="19dp"
                app:iconTint="@color/m3_on_surface" />
        </LinearLayout>

        <!-- Scrollable 4-column Grid of Actually Installed Apps -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/trayRowsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
